root ::= ("{\"tool\":\"read\"}" | "{\"tool\":\"recall\"}" | "{\"tool\":\"edit\",\"replacement\":" string ",\"citations\":" citations ",\"reason\":" string "}" | "{\"tool\":\"stop\",\"reason\":" string "}")
citations ::= "[" (string ("," string){0,4})? "]"
string ::= "\"" ([^"\\\x00-\x1f] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
